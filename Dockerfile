# Dockerfile generated by Forge at import time.
#
# Forge wrote this file because this repository resolved to a stack Forge
# recognises but carries no Dockerfile of its own. What chose this shape:
#
#   - the resolved buildKind is "nextjs", which the node-server template
#     family covers
#   - next.config.ts does not set output: 'standalone', so the runtime runs
#     `next start`
#   - the package manager resolved to npm, from the default (no packageManager
#     field and no non-npm lockfile)
#
# IT IS YOURS THE MOMENT YOU EDIT IT. Forge records this file's digest in
# .forge/app.json (dockerfile_sha256) and treats the file as Forge-owned only
# while the two still match. Change one byte and Forge's automated writers —
# this import path and the repair loop that runs after a failed build — never
# touch it again. Nothing has to be flipped or filed; the edit itself is the
# handover.
#
# The build stage is not optional on this lane. Forge's Stage workflow for an
# imported app runs `docker buildx build` and nothing else — no setup-node, no
# dependency install, no framework build — so unlike Forge's scaffold
# templates, whose CI builds the app before the image, this image builds the
# application itself. The dependency tree is installed twice on purpose: once
# in full so the build has its devDependencies, and once production-only so
# the runtime image does not ship a toolchain.
#
# Runtime posture: TCP
# 80, bound 0.0.0.0, a foreground CMD, logs on stdout, and root (binding :80 as
# an unprivileged user needs extra capabilities, and the non-root migration
# was tried and reverted: the port it moved to broke existing target groups).
# PORT=80 is set EXPLICITLY rather than left to the framework's default: it is
# the contract with the ECS task definition's container port, the load
# balancer's target group, and the security-group rules — a server that picks
# its own port listens where nothing is looking.
#
# The platform is NOT declared here. Stage builds with `--platform linux/amd64`,
# and a Dockerfile that pins its own architecture is the one failure mode that
# workflow calls out by name.

FROM node:22-alpine AS deps

WORKDIR /app

COPY . .

RUN npm install --omit=dev --no-audit --no-fund

FROM node:22-alpine AS build

WORKDIR /app

COPY . .

RUN npm install --no-audit --no-fund

RUN npx --no next build

# COPY has no conditional form and fails on a missing source, so a
# directory the runtime stage copies but the repository may not have is
# made to exist here rather than breaking every build without one.
RUN mkdir -p public

FROM node:22-alpine AS runtime

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=80

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public

EXPOSE 80

CMD ["npx", "--no", "next", "start", "-p", "80"]
